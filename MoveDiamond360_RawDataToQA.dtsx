          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"Use master
Go
ALTER DATABASE Diamond360_RawData SET SINGLE_USER WITH ROLLBACK IMMEDIATE

RESTORE DATABASE Diamond360_RawData
FROM DISK = '\\\\SUNVWIN360DB02\\amc\\D360Backups\\Diamond360_RawData_Backup.bak' WITH FILE = 1, 
MOVE 'Diamond360_RawData' TO '" + @[User::Diamond360_RawDataDataDrive]  + "\\Data\\" +  @[User::Diamond360_RawDataFileName] + ".mdf',
MOVE 'Diamond360_RawData_Log' TO '" + @[User::Diamond360_RawDataLogDrive]  + "\\Log\\" + @[User::Diamond360_RawDataFileName] +  ".ldf' ,
NOUNLOAD, REPLACE

ALTER DATABASE Diamond360_RawData SET MULTI_USER
GO"</DTS:PropertyExpression>
