          DTS:Description="Execute SQL Task"
          DTS:DTSID="{56432BEC-DAF4-41AF-A610-F2901066BC5D}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Restore GroupInsuranceExports On Live"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2012; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"RESTORE DATABASE GroupInsuranceExports_New 
FROM DISK = '\\\\SUNVWIN360DB02\\amc\\D360Backups\\GroupInsuranceExports.bak' 
WITH MOVE 'GroupInsuranceExports' TO '" + @[User::ExportsDataDrive]  + ":\\Data\\" +  @[User::ExportsFileName] + ".mdf',
MOVE 'GroupInsuranceExports_Log' TO '" + @[User::ExportsLogDrive]  + ":\\LDF\\" + @[User::ExportsFileName] +  ".ldf' 
GO"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{114B834E-92AF-4EEB-80E9-37E0FF6EE91E}"
              SQLTask:SqlStatementSource="RESTORE DATABASE GroupInsuranceExports_New &#xA;FROM DISK = '\\SUNVWIN360DB02\amc\D360Backups\GroupInsuranceExports.bak' &#xA;WITH MOVE 'GroupInsuranceExports' TO 'H:\Data\GroupInsuranceExport.mdf',&#xA;MOVE 'GroupInsuranceExports_Log' TO 'L:\LDF\GroupInsuranceExport.ldf' &#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
