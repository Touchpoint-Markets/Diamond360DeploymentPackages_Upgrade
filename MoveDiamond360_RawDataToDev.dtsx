      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D9C83537-9358-4432-BB24-5462B2454CAA}"
          SQLTask:SqlStatementSource="USE [Diamond360_RawData]&#xA;GO&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.database_principals WHERE name = N'EINAdmin')&#xA;DROP USER [EINAdmin]&#xA;GO&#xA;&#xA;CREATE USER [EINAdmin] FOR LOGIN [EINAdmin] WITH DEFAULT_SCHEMA=[EINAdmin]&#xA;GO&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.database_principals WHERE name = N'EINFinder')&#xA;DROP USER [EINFinder]&#xA;GO&#xA;&#xA;CREATE USER [EINFinder] FOR LOGIN [EINFinder] WITH DEFAULT_SCHEMA=[EINFinder]&#xA;GO&#xA;&#xA;ALTER ROLE [db_owner] ADD MEMBER [EINFinder] &#xA;GO&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.database_principals WHERE name = N'jdauser')&#xA;DROP USER [jdauser]&#xA;GO&#xA;&#xA;CREATE USER [jdauser] FOR LOGIN [jdauser] WITH DEFAULT_SCHEMA=[jdauser]&#xA;GO&#xA;&#xA;ALTER ROLE [db_owner] ADD MEMBER [jdauser]&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
