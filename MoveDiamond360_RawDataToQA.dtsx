      DTS:refId="Package\Setup EINFinder Logins"
      DTS:CreationName="Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=11.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{a4b73553-d66d-479a-9b9c-27feee3993ee}"
      DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=11.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
      DTS:LocaleID="-1"
      DTS:ObjectName="Setup EINFinder Logins"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2012; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{10B6F020-BF0C-4A33-9CD0-7A1222183C91}"
          SQLTask:SqlStatementSource="USE [Diamond360_RawData]&#xA;GO&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.database_principals WHERE name = N'EINAdmin')&#xA;DROP USER [EINAdmin]&#xA;GO&#xA;&#xA;CREATE USER [EINAdmin] FOR LOGIN [EINAdmin] WITH DEFAULT_SCHEMA=[EINAdmin]&#xA;GO&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.database_principals WHERE name = N'EINFinder')&#xA;DROP USER [EINFinder]&#xA;GO&#xA;&#xA;CREATE USER [EINFinder] FOR LOGIN [EINFinder] WITH DEFAULT_SCHEMA=[EINFinder]&#xA;GO&#xA;&#xA;ALTER ROLE [db_owner] ADD MEMBER [EINFinder] &#xA;GO&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.database_principals WHERE name = N'jdauser')&#xA;DROP USER [jdauser]&#xA;GO&#xA;&#xA;CREATE USER [jdauser] FOR LOGIN [jdauser] WITH DEFAULT_SCHEMA=[jdauser]&#xA;GO&#xA;&#xA;ALTER ROLE [db_owner] ADD MEMBER [jdauser]&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
