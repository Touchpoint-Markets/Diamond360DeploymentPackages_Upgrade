        <SQLTask:SqlTaskData
          SQLTask:Connection="{6A28F843-5278-4C1F-8C4B-8F07991906F5}"
          SQLTask:SqlStatementSource="Use Diamond360;&#xA;&#xA;EXEC dbo.EINFinder_MOVEQA_GIBASIC;&#xA;&#xA;CHECKPOINT;&#xA;DBCC FREESYSTEMCACHE ('ALL');&#xA;DBCC FREEPROCCACHE;&#xA;&#xA;EXEC dbo.EINFinder_MOVEQA_GIPROPRIETARY;&#xA;&#xA;CHECKPOINT;&#xA;DBCC FREESYSTEMCACHE ('ALL');&#xA;DBCC FREEPROCCACHE;&#xA;&#xA;EXEC dbo.EINFINDER_MOVEQA_GISCHEDULES;&#xA;&#xA;CHECKPOINT;&#xA;DBCC FREESYSTEMCACHE ('ALL');&#xA;DBCC FREEPROCCACHE;&#xA;&#xA;EXEC dbo.EINFINDER_MOVEQA_RPPBASIC;&#xA;&#xA;CHECKPOINT;&#xA;DBCC FREESYSTEMCACHE ('ALL');&#xA;DBCC FREEPROCCACHE;&#xA;&#xA;EXEC dbo.EINFINDER_MOVEQA_RPPPROPRIETARY;&#xA;&#xA;CHECKPOINT;&#xA;DBCC FREESYSTEMCACHE ('ALL');&#xA;DBCC FREEPROCCACHE;&#xA;&#xA;EXEC dbo.EINFINDER_MOVEQA_RPPSCHEDULES;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
