              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Data.SqlClient;
using System.Net;
using System.Net.Mail;
#endregion

namespace ST_b3024ac85bcc4c98814bb21e6257a9fb
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private static string _importsDir = string.Empty;

        static ScriptMain()
        {
            AppDomain.CurrentDomain.AssemblyResolve += (sender, args) =>
            {
                var asmName = new System.Reflection.AssemblyName(args.Name);

                var dtsTasksDir = System.IO.Path.Combine(
                    System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFiles),
                    @"Microsoft SQL Server\160\DTS\Tasks");

                var nuget = (System.Environment.GetEnvironmentVariable("NUGET_PACKAGES")
                    ?? System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.UserProfile), ".nuget", "packages"))
                    .TrimEnd(new char[]{'\\', '/'}) + System.IO.Path.DirectorySeparatorChar.ToString();

                var map = new System.Collections.Generic.Dictionary<string, string[]>(System.StringComparer.OrdinalIgnoreCase)
                {
                    { "AWSSDK.Core",           new string[] { "AWSSDK.Core.dll",           nuget + @"awssdk.core\3.7.500\lib\net45\AWSSDK.Core.dll" } },
                    { "AWSSDK.SecretsManager", new string[] { "AWSSDK.SecretsManager.dll", nuget + @"awssdk.secretsmanager\3.7.500\lib\net45\AWSSDK.SecretsManager.dll" } }
                };

                string[] entry;
                if (!map.TryGetValue(asmName.Name, out entry)) return null;

                foreach (var dir in new string[] { _importsDir, dtsTasksDir })
                {
                    if (!string.IsNullOrEmpty(dir))
                    {
                        var candidate = System.IO.Path.Combine(dir, entry[0]);
                        if (System.IO.File.Exists(candidate))
                            return System.Reflection.Assembly.LoadFrom(candidate);
                    }
                }

                if (System.IO.File.Exists(entry[1]))
                    return System.Reflection.Assembly.LoadFrom(entry[1]);

                return null;
            };
        }

        private static string GetSecretString(string secretName, string region)
        {
            using (var client = new Amazon.SecretsManager.AmazonSecretsManagerClient(Amazon.RegionEndpoint.GetBySystemName(region)))
            {
                var response = client.GetSecretValue(new Amazon.SecretsManager.Model.GetSecretValueRequest { SecretId = secretName });
                return response.SecretString;
            }
        }

        private static string ExtractJsonStringField(string json, string fieldName)
        {
            var match = System.Text.RegularExpressions.Regex.Match(json, "\"" + fieldName + "\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"");
            if (!match.Success)
                throw new System.Exception("Field '" + fieldName + "' not found in secret.");
            return match.Groups[1].Value.Replace("\\\"", "\"").Replace("\\\\", "\\");
        }

        public void Main()
        {
            _importsDir = Dts.Variables["User::ImportsPath"].Value.ToString();
            RunMain();
        }

        private void RunMain()
        {
            string emailMessage = null;

            emailMessage = "<html><div style=''font-size:10px; font-family:Consolas;''>";
            emailMessage = emailMessage + "New Prospector data is now available for testing. Please see below for a sample of new ACK IDs:<br><br>";

            ConnectionManager cm = Dts.Connections["Diamond360"];
            object rawConnection = cm.AcquireConnection(Dts.Transaction);
            SqlConnection SQLConn = (SqlConnection)rawConnection;

            string prospectorTestRecordsQuery = null;

            prospectorTestRecordsQuery = "EXEC [Prospector].[GetTestRecords]";

            SqlCommand prospectorTestRecordsCmd = new SqlCommand(prospectorTestRecordsQuery, SQLConn);

            SqlDataReader prospectorTestRecordsReader = null;
            prospectorTestRecordsCmd.CommandTimeout = 0;
            prospectorTestRecordsReader = prospectorTestRecordsCmd.ExecuteReader();


            if (prospectorTestRecordsReader.HasRows)
            {

                emailMessage = emailMessage + "<table border='1'; width=100%;'>";
                emailMessage = emailMessage + "<tr><th width='24%';>ACK ID</th><th width='8%';>EIN</th><th width='6%';>Year</th><th width='62%';>Plan Name</th></tr>";


                while (prospectorTestRecordsReader.Read())
                {
                    emailMessage = emailMessage + "<tr><td>" + prospectorTestRecordsReader["ACK_ID"].ToString() + "</td>";
                    emailMessage = emailMessage + "<td>" + prospectorTestRecordsReader["EIN"].ToString() + "</td>";
                    emailMessage = emailMessage + "<td>" + prospectorTestRecordsReader["FilingYear"].ToString() + "</td>";
                    emailMessage = emailMessage + "<td>" + prospectorTestRecordsReader["PlanName"].ToString() + "</td></tr>";

                }

                emailMessage = emailMessage + "</table><br><br><br>";

            }

            prospectorTestRecordsReader.Close();

            string groupTestRecordsQuery = null;

            groupTestRecordsQuery = "EXEC [GroupInsurance].[GetTestRecords]";

            SqlCommand groupTestRecordsCmd = new SqlCommand(groupTestRecordsQuery, SQLConn);

            SqlDataReader groupTestRecordsReader = null;
            groupTestRecordsCmd.CommandTimeout = 0;
            groupTestRecordsReader = groupTestRecordsCmd.ExecuteReader();


            if (groupTestRecordsReader.HasRows)
            {

                emailMessage = emailMessage + "<table border='1'; width=100%;'>";
                emailMessage = emailMessage + "<tr><th width='24%';>ACK ID</th><th width='8%';>EIN</th><th width='6%';>Year</th><th width='62%';>Plan Name</th></tr>";


                while (groupTestRecordsReader.Read())
                {
                    emailMessage = emailMessage + "<tr><td>" + groupTestRecordsReader["ACK_ID"].ToString() + "</td>";
                    emailMessage = emailMessage + "<td>" + groupTestRecordsReader["EIN"].ToString() + "</td>";
                    emailMessage = emailMessage + "<td>" + groupTestRecordsReader["FilingYear"].ToString() + "</td>";
                    emailMessage = emailMessage + "<td>" + groupTestRecordsReader["PlanName"].ToString() + "</td></tr>";

                }

                emailMessage = emailMessage + "</table><br>";

            }

            groupTestRecordsReader.Close();

            emailMessage = emailMessage + "</div></html>";
            Dts.Log(emailMessage, 0, null);

            int sendEmailFlag = (int)Dts.Variables["$Project::sendEmailFlag"].Value;

            if (sendEmailFlag == 1)
            {
                string smtpServer = Dts.Variables["$Project::SmtpServer"].Value.ToString();
                string awsSecretName = Dts.Variables["$Project::AwsSecretName"].Value.ToString();
                string awsRegion = Dts.Variables["$Project::AwsRegion"].Value.ToString();
                string smtpSecretJson = GetSecretString(awsSecretName, awsRegion);
                string smtpUserName = ExtractJsonStringField(smtpSecretJson, "UserName");
                string smtpPassword = ExtractJsonStringField(smtpSecretJson, "Password");

                ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072;

                using (MailMessage mail = new MailMessage())
                using (SmtpClient client = new SmtpClient(smtpServer, 587))
                {
                    mail.From = new MailAddress(Dts.Variables["$Project::EmailFromAddress"].Value.ToString());
                    mail.To.Add(new MailAddress("harshah@synoptek.com"));
                    mail.CC.Add("Ron.Lubke@arc-network.com,Eric.ryles@arc-network.com,lynn.kruetzkamp@arc-network.com,hvaghasiya@synoptek.com,mbhavsar@synoptek.com");
                    mail.Subject = "New Prospector Data Cycle Sample ACK IDs";
                    mail.IsBodyHtml = true;
                    mail.Body = emailMessage;

                    client.EnableSsl = true;
                    client.Credentials = new NetworkCredential(smtpUserName, smtpPassword);
                    client.Send(mail);
                    Dts.Log("New Prospector Data Cycle Sample ACK IDs : Mail Sent !", 0, null);
                }
            }

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };

    }
}]]></ProjectItem>
