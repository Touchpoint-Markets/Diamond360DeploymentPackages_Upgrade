            Dts.Variables["Diamond360FileName"].Value = String.Format("Diamond360_{0}_{1}_{2}_{3}_{4}_{5}", DateTime.Now.Month.ToString(), DateTime.Now.Day.ToString(), DateTime.Now.Year.ToString(), DateTime.Now.Hour.ToString(), DateTime.Now.Minute.ToString(), DateTime.Now.Second.ToString());
           
