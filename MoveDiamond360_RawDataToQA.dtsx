      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Restore Backups\Restore Diamond360_RawData On QA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C0DD0BA8-E80A-4787-AD93-778E7F0EF440}"
