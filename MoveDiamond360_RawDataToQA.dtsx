      DTS:LocaleID="-1"
      DTS:ObjectName="Restore Backups">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Restore Backups\Restore Diamond360_RawData On QA"
          DTS:CreationName="Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=11.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C0DD0BA8-E80A-4787-AD93-778E7F0EF440}"
          DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=11.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91"
          DTS:LocaleID="-1"
          DTS:ObjectName="Restore Diamond360_RawData On QA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2012; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"Use master
Go
ALTER DATABASE Diamond360_RawData SET SINGLE_USER WITH ROLLBACK IMMEDIATE

RESTORE DATABASE Diamond360_RawData
FROM DISK = '\\\\SUNVWIN360DB02\\amc\\D360Backups\\Diamond360_RawData_Backup.bak' WITH FILE = 1, 
MOVE 'Diamond360_RawData' TO '" + @[User::Diamond360_RawDataDataDrive]  + "\\Data\\" +  @[User::Diamond360_RawDataFileName] + ".mdf',
MOVE 'Diamond360_RawData_Log' TO '" + @[User::Diamond360_RawDataLogDrive]  + "\\Log\\" + @[User::Diamond360_RawDataFileName] +  ".ldf' ,
NOUNLOAD, REPLACE

ALTER DATABASE Diamond360_RawData SET MULTI_USER
GO"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{10B6F020-BF0C-4A33-9CD0-7A1222183C91}"
              SQLTask:SqlStatementSource="Use master&#xA;Go&#xA;ALTER DATABASE Diamond360_RawData SET SINGLE_USER WITH ROLLBACK IMMEDIATE&#xA;&#xA;RESTORE DATABASE Diamond360_RawData&#xA;FROM DISK = '\\SUNVWIN360DB02\amc\D360Backups\Diamond360_RawData_Backup.bak' WITH FILE = 1, &#xA;MOVE 'Diamond360_RawData' TO 'F:\Data\.mdf',&#xA;MOVE 'Diamond360_RawData_Log' TO 'F:\Log\.ldf' ,&#xA;NOUNLOAD, REPLACE&#xA;&#xA;ALTER DATABASE Diamond360_RawData SET MULTI_USER&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
