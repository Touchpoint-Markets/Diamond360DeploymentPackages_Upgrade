    <DTS:Executable
      DTS:refId="Package\Restore Backups"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{539584B8-68AA-43D4-9AD1-624BAF705BF0}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Restore Backups">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Restore Backups\Restore ProspectorExports On QA"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{499C00F1-09C8-4FA6-BE3F-967A65056FC8}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Restore ProspectorExports On QA"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2012; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"Use master
Go
ALTER DATABASE ProspectorExports SET SINGLE_USER WITH ROLLBACK IMMEDIATE

RESTORE DATABASE ProspectorExports
FROM DISK = '\\\\SUNVWIN360DB02\\amc\\D360Backups\\ProspectorExports.bak' 
WITH FILE = 1, MOVE 'ProspectorExports' TO '" + @[User::ExportsDataDrive]  + "\\Data\\" +  @[User::ExportsFileName] + ".mdf',
MOVE 'ProspectorExports_Log' TO '" + @[User::ExportsLogDrive]  + "\\Data\\" + @[User::ExportsFileName] +  ".ldf' ,
NOUNLOAD, REPLACE

ALTER DATABASE ProspectorExports SET MULTI_USER
GO"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{6A28F843-5278-4C1F-8C4B-8F07991906F5}"
              SQLTask:SqlStatementSource="Use master&#xA;Go&#xA;ALTER DATABASE ProspectorExports SET SINGLE_USER WITH ROLLBACK IMMEDIATE&#xA;&#xA;RESTORE DATABASE ProspectorExports&#xA;FROM DISK = '\\SUNVWIN360DB02\amc\D360Backups\ProspectorExports.bak' &#xA;WITH FILE = 1, MOVE 'ProspectorExports' TO 'E:\Program Files\Microsoft SQL Server\MSSQL15.CINVSQL24\MSSQL\Data\.mdf',&#xA;MOVE 'ProspectorExports_Log' TO 'F:\Program Files\Microsoft SQL Server\MSSQL15.CINVSQL24\MSSQL\Data\.ldf' ,&#xA;NOUNLOAD, REPLACE&#xA;&#xA;ALTER DATABASE ProspectorExports SET MULTI_USER&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
