      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{114B834E-92AF-4EEB-80E9-37E0FF6EE91E}"
          SQLTask:SqlStatementSource="IF  EXISTS (SELECT name FROM master.dbo.sysdatabases WHERE name = N'GroupInsuranceExports_Old')&#xA;EXEC msdb.dbo.sp_delete_database_backuphistory @database_name = N'GroupInsuranceExports_Old'&#xA;GO&#xA;USE [master]&#xA;GO&#xA;IF  EXISTS (SELECT name FROM master.dbo.sysdatabases WHERE name = N'GroupInsuranceExports_Old')&#xA;ALTER DATABASE [GroupInsuranceExports_Old] SET  SINGLE_USER WITH ROLLBACK IMMEDIATE&#xA;GO&#xA;USE [master]&#xA;GO&#xA;IF  EXISTS (SELECT name FROM master.dbo.sysdatabases WHERE name = N'GroupInsuranceExports_Old')&#xA;DROP DATABASE [GroupInsuranceExports_Old]&#xA;GO&#xA;&#xA;IF  EXISTS (SELECT name FROM master.dbo.sysdatabases WHERE name = N'GroupInsuranceExports_New')&#xA;EXEC msdb.dbo.sp_delete_database_backuphistory @database_name = N'GroupInsuranceExports_New'&#xA;GO&#xA;USE [master]&#xA;GO&#xA;IF  EXISTS (SELECT name FROM master.dbo.sysdatabases WHERE name = N'GroupInsuranceExports_New')&#xA;ALTER DATABASE [GroupInsuranceExports_New] SET  SINGLE_USER WITH ROLLBACK IMMEDIATE&#xA;GO&#xA;USE [master]&#xA;GO&#xA;IF  EXISTS (SELECT name FROM master.dbo.sysdatabases WHERE name = N'GroupInsuranceExports_New')&#xA;DROP DATABASE [GroupInsuranceExports_New]&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
