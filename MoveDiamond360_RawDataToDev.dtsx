          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2012; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"ALTER DATABASE Diamond360_RawData SET SINGLE_USER WITH ROLLBACK IMMEDIATE

RESTORE DATABASE Diamond360_RawData
FROM DISK = '\\\\Sunvwin360db01\\amc\\D360Backups\\Diamond360_RawData_Backup.bak' WITH FILE = 1, 
MOVE 'Diamond360_RawData' TO '" + @[User::Diamond360_RawDataDataDrive]  + ":\\Data\\" +  @[User::Diamond360_RawDataFileName] + ".mdf',
MOVE 'Diamond360_RawData_Log' TO '" + @[User::Diamond360_RawDataLogDrive]  + ":\\Logs\\" + @[User::Diamond360_RawDataFileName] +  ".ldf' ,
NOUNLOAD, REPLACE

ALTER DATABASE Diamond360_RawData SET MULTI_USER
GO"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{D9C83537-9358-4432-BB24-5462B2454CAA}"
              SQLTask:SqlStatementSource="ALTER DATABASE Diamond360_RawData SET SINGLE_USER WITH ROLLBACK IMMEDIATE&#xA;&#xA;RESTORE DATABASE Diamond360_RawData&#xA;FROM DISK = '\\Sunvwin360db01\amc\D360Backups\Diamond360_RawData_Backup.bak' WITH FILE = 1, &#xA;MOVE 'Diamond360_RawData' TO 'E:\Data\.mdf',&#xA;MOVE 'Diamond360_RawData_Log' TO 'J:\Logs\.ldf' ,&#xA;NOUNLOAD, REPLACE&#xA;&#xA;ALTER DATABASE Diamond360_RawData SET MULTI_USER&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
