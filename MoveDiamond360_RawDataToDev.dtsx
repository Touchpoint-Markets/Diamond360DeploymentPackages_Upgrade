		public void Main()
		{
			// TODO: Add your code here
            Dts.Variables["Diamond360_RawDataFileName"].Value = String.Format("Diamond360_RawData_{0}_{1}_{2}_{3}_{4}_{5}", DateTime.Now.Month.ToString(), DateTime.Now.Day.ToString(), DateTime.Now.Year.ToString(), DateTime.Now.Hour.ToString(), DateTime.Now.Minute.ToString(), DateTime.Now.Second.ToString());
            Dts.Variables["Diamond360_RawDataFilestreamName"].Value = String.Format("SummitFileStream_{0}_{1}_{2}_{3}_{4}_{5}", DateTime.Now.Month.ToString(), DateTime.Now.Day.ToString(), DateTime.Now.Year.ToString(), DateTime.Now.Hour.ToString(), DateTime.Now.Minute.ToString(), DateTime.Now.Second.ToString());
           
			Dts.TaskResult = (int)ScriptResults.Success;
		}

