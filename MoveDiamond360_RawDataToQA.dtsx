              SQLTask:SqlStatementSource="Use master&#xA;Go&#xA;ALTER DATABASE Diamond360_RawData SET SINGLE_USER WITH ROLLBACK IMMEDIATE&#xA;&#xA;RESTORE DATABASE Diamond360_RawData&#xA;FROM DISK = '\\10.9.51.101\Backup\Diamond360_RawData_Backup.bak' WITH FILE = 1, &#xA;MOVE 'Diamond360_RawData' TO 'F:\Program Files\Microsoft SQL Server\MSSQL15.CINVSQL24\MSSQL\Data\.mdf',&#xA;MOVE 'Diamond360_RawData_Log' TO 'F:\Program Files\Microsoft SQL Server\MSSQL15.CINVSQL24\MSSQL\Data\.ldf' ,&#xA;NOUNLOAD, REPLACE&#xA;&#xA;ALTER DATABASE Diamond360_RawData SET MULTI_USER&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
