      DTS:refId="Package\Restore Backups"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{18B3804F-673F-473C-9272-7D46F35C28D2}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Restore Backups">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Restore Backups\Restore Diamond360_RawData On Live"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{598EE61A-DFAF-482D-A410-6F24984C5A5B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Restore Diamond360_RawData On Live"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2012; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"RESTORE DATABASE Diamond360_RawData_New 
FROM DISK = '\\\\SUNVWIN360DB02\\amc\\D360Backups\\Diamond360_RawData_Backup.bak' 
WITH MOVE 'Diamond360_RawData' TO '" + @[User::Diamond360_RawDataDataDrive]  + ":\\Data\\" +  @[User::Diamond360_RawDataFileName] + ".mdf',
MOVE 'Diamond360_RawData_Log' TO '" + @[User::Diamond360_RawDataLogDrive]  + ":\\LDF\\" + @[User::Diamond360_RawDataFileName] +  ".ldf' 
GO"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{114B834E-92AF-4EEB-80E9-37E0FF6EE91E}"
              SQLTask:SqlStatementSource="RESTORE DATABASE Diamond360_RawData_New &#xA;FROM DISK = '\\SUNVWIN360DB02\amc\D360Backups\Diamond360_RawData_Backup.bak' &#xA;WITH MOVE 'Diamond360_RawData' TO 'H:\Data\.mdf',&#xA;MOVE 'Diamond360_RawData_Log' TO 'L:\LDF\.ldf' &#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Setup EINFinder Logins"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0F850496-45EE-4E1D-9CDD-9A85D6F2323F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Setup EINFinder Logins"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2012; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{114B834E-92AF-4EEB-80E9-37E0FF6EE91E}"
          SQLTask:SqlStatementSource="USE [Diamond360_RawData_New]&#xA;GO&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.database_principals WHERE name = N'EINAdmin')&#xA;DROP USER [EINAdmin]&#xA;GO&#xA;&#xA;CREATE USER [EINAdmin] FOR LOGIN [EINAdmin] WITH DEFAULT_SCHEMA=[EINAdmin]&#xA;GO&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.database_principals WHERE name = N'EINFinder')&#xA;DROP USER [EINFinder]&#xA;GO&#xA;&#xA;CREATE USER [EINFinder] FOR LOGIN [EINFinder] WITH DEFAULT_SCHEMA=[EINFinder]&#xA;GO&#xA;&#xA;ALTER ROLE [db_owner] ADD MEMBER [EINFinder] &#xA;GO&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.database_principals WHERE name = N'jdauser')&#xA;DROP USER [jdauser]&#xA;GO&#xA;&#xA;CREATE USER [jdauser] FOR LOGIN [jdauser] WITH DEFAULT_SCHEMA=[jdauser]&#xA;GO&#xA;&#xA;ALTER ROLE [db_owner] ADD MEMBER [jdauser]&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
