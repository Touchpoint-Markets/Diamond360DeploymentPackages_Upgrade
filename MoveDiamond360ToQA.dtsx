          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"Use Master
Go
ALTER DATABASE Diamond360 SET SINGLE_USER WITH ROLLBACK IMMEDIATE

RESTORE DATABASE Diamond360
FROM DISK = '\\\\10.9.51.101\\Backup\\Diamond360_Backup.bak' 
WITH FILE = 1, MOVE 'Diamond360' TO '" + @[User::Diamond360DataDrive]  + "\\Data\\" +  @[User::Diamond360FileName] + ".mdf',
MOVE 'Diamond360_Log' TO '" + @[User::Diamond360LogDrive]  + "\\Data\\" + @[User::Diamond360FileName] +  ".ldf',
NOUNLOAD, REPLACE

ALTER DATABASE Diamond360 SET MULTI_USER
GO"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{6A28F843-5278-4C1F-8C4B-8F07991906F5}"
              SQLTask:SqlStatementSource="Use Master&#xA;Go&#xA;ALTER DATABASE Diamond360 SET SINGLE_USER WITH ROLLBACK IMMEDIATE&#xA;&#xA;RESTORE DATABASE Diamond360&#xA;FROM DISK = '\\10.9.51.101\Backup\Diamond360_Backup.bak' &#xA;WITH FILE = 1, MOVE 'Diamond360' TO 'E:\Program Files\Microsoft SQL Server\MSSQL15.CINVSQL24\MSSQL\Data\.mdf',&#xA;MOVE 'Diamond360_Log' TO 'F:\Program Files\Microsoft SQL Server\MSSQL15.CINVSQL24\MSSQL\Data\.ldf',&#xA;NOUNLOAD, REPLACE&#xA;&#xA;ALTER DATABASE Diamond360 SET MULTI_USER&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
